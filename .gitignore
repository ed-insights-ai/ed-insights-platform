# Node
node_modules/
.next/
dist/
out/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Environment
.env
.env.local
.env.*.local

# Data outputs (scratch/temp only; pipeline parquets are reproducible build output)
data/
!packages/pipeline/data/
packages/pipeline/data/structured/**/*.parquet
packages/pipeline/data/*.parquet

# Raw scraped HTML is a re-fetchable cache, not an artifact. The blanket negation
# above swept it into git by accident: 2,140 files / 1.1 GB. This rule stops the
# GROWTH without rewriting history — .gitignore is only consulted for UNTRACKED
# files, so every already-committed page stays tracked (old box scores may no
# longer be served, and re-parsing them offline is how we repair 2016-2025),
# while every page fetched from the 2026 season onward is ignored. Without this,
# a twice-weekly in-season refresh adds ~260 files per run.
packages/pipeline/data/raw_html/

# IDE
.vscode/
.idea/

# Playwright
.playwright-mcp/

# OS
.DS_Store

# Gas Town runtime (not part of the project)
.runtime/
.claude/*
# Slash commands are project assets, not local runtime — they travel with the repo.
!.claude/commands/
.logs/
state.json

# Keelson workflow run worktrees (created by isolated runs)
.worktrees/

# Beads issue tracker. The Dolt database is machine-local and rebuildable, but
# issues.jsonl is the committed record of what we are building — the plan has to
# survive a fresh clone, and it is what ROADMAP.md is generated from.
.beads/*
!.beads/issues.jsonl
.dolt/
*.db
.beads-credential-key
